---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            .game-container {
                background-color: #1a1a1a;
                color: #e0e0e0;
                padding: 30px;
                border-radius: 12px;
                margin-top: 2rem;
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
                text-align: center;
                font-family: system-ui, -apple-system, sans-serif;
            }
            .dashboard {
                display: flex;
                justify-content: space-between;
                margin-bottom: 20px;
                font-size: 1.2rem;
                font-weight: bold;
                background: #2a2a2a;
                padding: 15px;
                border-radius: 8px;
                border: 1px solid #333;
            }
            .stat { color: #4ade80; }
            
            .grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 15px;
                max-width: 400px;
                margin: 0 auto;
            }
            
            .crop-patch {
                aspect-ratio: 1;
                background-color: #2d3748;
                border: 2px solid #4a5568;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 3rem;
                cursor: crosshair;
                transition: all 0.1s;
                user-select: none;
            }
            
            .crop-patch:active {
                transform: scale(0.95);
                background-color: #4a5568;
            }

            .pest-active {
                background-color: #742a2a;
                border-color: #fc8181;
            }

            button {
                margin-top: 25px;
                padding: 12px 24px;
                font-size: 1.1rem;
                background-color: #4ade80;
                color: #1a1a1a;
                border: none;
                border-radius: 6px;
                font-weight: bold;
                cursor: pointer;
                transition: background-color 0.2s;
            }
            
            button:hover { background-color: #22c55e; }
            button:disabled { background-color: #4b5563; cursor: not-allowed; }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <h1>🚁 Sensor Calibration PoC</h1>
            <p>
                Test the autonomous targeting array. Click the pests (🐛) as soon as they appear in the crop grid to register a successful drone scan. You have 30 seconds.
            </p>
            
            <div class="game-container">
                <div class="dashboard">
                    <div>Pests Scanned: <span id="score" class="stat">0</span></div>
                    <div>Uplink Time: <span id="time-left" class="stat">30</span>s</div>
                </div>

                <div class="grid">
                    <div class="crop-patch" id="0">🌱</div>
                    <div class="crop-patch" id="1">🌱</div>
                    <div class="crop-patch" id="2">🌱</div>
                    <div class="crop-patch" id="3">🌱</div>
                    <div class="crop-patch" id="4">🌱</div>
                    <div class="crop-patch" id="5">🌱</div>
                    <div class="crop-patch" id="6">🌱</div>
                    <div class="crop-patch" id="7">🌱</div>
                    <div class="crop-patch" id="8">🌱</div>
                </div>

                <button id="start-btn">Initialize Sequence</button>
            </div>
        </main>
        <Footer />

        <script>
            const squares = document.querySelectorAll('.crop-patch');
            const timeLeft = document.querySelector('#time-left');
            const scoreDisplay = document.querySelector('#score');
            const startBtn = document.querySelector('#start-btn');

            let result = 0;
            let hitPosition = null;
            let currentTime = 30;
            let timerId = null;
            let pestTimerId = null;
            let isPlaying = false;

            function randomSquare() {
                squares.forEach(square => {
                    square.classList.remove('pest-active');
                    square.textContent = '🌱';
                });

                let randomPosition = squares[Math.floor(Math.random() * 9)];
                randomPosition.classList.add('pest-active');
                randomPosition.textContent = '🐛';
                hitPosition = randomPosition.id;
            }

            squares.forEach(square => {
                square.addEventListener('mousedown', () => {
                    if (square.id == hitPosition && isPlaying) {
                        result++;
                        scoreDisplay.textContent = result;
                        hitPosition = null;
                        square.textContent = '🎯';
                        square.classList.remove('pest-active');
                    }
                });
            });

            function movePest() {
                pestTimerId = setInterval(randomSquare, 700);
            }

            function countDown() {
                currentTime--;
                if(timeLeft) timeLeft.textContent = currentTime.toString();

                if (currentTime === 0) {
                    clearInterval(timerId);
                    clearInterval(pestTimerId);
                    isPlaying = false;
                    startBtn.disabled = false;
                    startBtn.textContent = "Run Diagnostics Again";
                    
                    squares.forEach(square => {
                        square.classList.remove('pest-active');
                        square.textContent = '🌱';
                    });
                    
                    alert(`Uplink terminated. Total successful scans: ${result}`);
                }
            }

            startBtn?.addEventListener('click', () => {
                if (isPlaying) return;
                
                // Reset stats
                result = 0;
                currentTime = 30;
                scoreDisplay.textContent = result.toString();
                timeLeft.textContent = currentTime.toString();
                
                isPlaying = true;
                startBtn.disabled = true;
                startBtn.textContent = "Sensors Active...";

                movePest();
                timerId = setInterval(countDown, 1000);
            });
        </script>
    </body>
</html>
